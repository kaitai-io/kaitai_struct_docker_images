#!/bin/sh -ef

nextest_version=0.9.148
nextest_tarball=cargo-nextest-${nextest_version}-x86_64-unknown-linux-gnu.tar.gz

# Download a specific release, see
# https://nexte.st/docs/installation/release-urls/#version-identifier, and check
# its SHA-256 hash against a `${nextest_tarball}.sha256` file. The hash in this
# file was verified as follows:
#
# 1. It matches the `.sha256` file published next to the tarball in the GitHub
#    release at https://github.com/nextest-rs/nextest/releases.
# 2. It matches the hash printed in the log of the CI job that built the
#    tarball (the "Build cargo-nextest binaries for x86_64-unknown-linux-gnu"
#    job of the release workflow run for the `cargo-nextest-${nextest_version}`
#    tag at https://github.com/nextest-rs/nextest/actions/workflows/release.yml).
curl -fsSL -o "${nextest_tarball}" "https://get.nexte.st/${nextest_version}/x86_64-unknown-linux-gnu.tar.gz"
sha256sum -c -w "${nextest_tarball}.sha256"

tar -xzvf "${nextest_tarball}" -C "${CARGO_HOME:-~/.cargo}"/bin
rm -f "${nextest_tarball}"
